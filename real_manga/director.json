    {
      "id": "rm_003",
      "page": "real_manga/pages/p04.jpg",
      "motion": "HOLD",
      "transition_out": "CUT",
      "narration": {
        "text": "车厢里，大家聊得起劲。而说起青函隧道，隼人的话匣子一下子打开了。轰隆隆隆，列车钻进了海底。",
        "voice": "narrator",
        "audio": "real_manga/audio/rm_003.mp3"
      }
    },
    {
