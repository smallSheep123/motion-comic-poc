      "page": "real_manga/pages/p03.jpg",
      "motion": "HOLD",
      "transition_out": "CROSSFADE",
      "narration": {
        "text": "别误会，龙司、龙、新巴、雷、银、小常、鹰虎，全都约好了坐飞机过去。好久不见，想想就开心。",
        "voice": "narrator",
        "audio": "real_manga/audio/rm_002.mp3",
        "subject": [
          0.1046,
          0.0817,
          0.8968,
          0.6183
