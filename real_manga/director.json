    {
      "id": "rm_001",
      "page": "real_manga/pages/p01.jpg",
      "motion": "HOLD",
      "transition_out": "CROSSFADE",
      "narration": {
        "text": "故事从一通突然的求救电话开始。有人问：等等，为什么连我们都叫去北海道旅行？答案——是朋友们收到了吃不完的乌贼饭。",
        "voice": "narrator",
        "audio": "real_manga/audio/rm_001.mp3",
        "subject": [
          0.1041,
          0.08,
